# Copia este archivo a .env y completa tu clave (el .env nunca se sube a git)

# Proveedor de IA: gemini (por defecto) o claude
AI_PROVIDER=gemini

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite,gemma-4-26b-a4b-it

# --- Claude (solo si AI_PROVIDER=claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=3000
# Proyecto de Firebase, para validar el token de sesión de los usuarios
FIREBASE_PROJECT_ID=buscador-notas
# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:4200,https://buscador-notas.web.app,https://buscador-notas.firebaseapp.com
